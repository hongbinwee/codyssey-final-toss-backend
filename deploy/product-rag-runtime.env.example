# PostgreSQL is the existing 5432 instance. Replace values locally; never commit secrets.
RAG_DATABASE_URL=postgresql://rag_runtime:REPLACE_ME@127.0.0.1:5432/toss_rag
COMMERCE_DATABASE_URL=postgresql://commerce_reader:REPLACE_ME@127.0.0.1:5432/toss
COMMERCE_SCHEMA_MAP=test_items2:test_items2,test_items:test_items,test_earphones:test_earphones,commerce:public

RAG_DEFAULT_PROFILE=test_items2
RAG_ALLOWED_PROFILES=test_items2,all_products
RAG_REQUIRE_IN_STOCK=true
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_PATH=/home/aiteam/.cache/codex-rag-fastembed
RAG_CHUNK_MAX_TOKENS=96
RAG_EMBEDDING_BATCH_SIZE=64
RAG_CANDIDATE_DEPTH=50
RAG_CHUNKS_PER_PRODUCT=3
RAG_CANDIDATE_SCAN_LIMIT=2000
RAG_RRF_K=60
# Optional external editable registry, with the same JSON shape as the packaged one.
# RAG_PRODUCT_TYPE_REGISTRY=/app/config/product_types.json
