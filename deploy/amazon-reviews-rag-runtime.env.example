# Runtime account has access to `rag` only; do not add the bootstrap URL here.
AMAZON_REVIEWS_API_BASE_URL=http://127.0.0.1:8000
RAG_DATABASE_URL=postgresql://amazon_rag:REPLACE_ME@127.0.0.1:5432/toss_rag
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_PATH=.cache/fastembed
RAG_CHUNK_MAX_TOKENS=96
RAG_EMBEDDING_BATCH_SIZE=64
RAG_HTTP_TIMEOUT_SECONDS=20
RAG_HTTP_RETRIES=2
RAG_MAX_RESPONSE_BYTES=10485760
RAG_CHANNEL_DEPTH=20
RAG_RRF_K=60
# Set only after a tuning/holdout review establishes a threshold.
# RAG_MIN_RRF_SCORE=
